DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5433/pblindadas_finanzas?schema=public"
PORT=3000
HOST=127.0.0.1
# Sólo desarrollo local. En producción se exige reemplazar la interfaz.
M4_CORREO=desarrollo
M4_URL_VISTA=http://127.0.0.1:5174
M4_ORIGENES=http://127.0.0.1:5174,http://localhost:5174
# Política técnica vigente: ver documentacion/ESTADO_TECNICO_VIGENTE.md
M4_LONGITUD_MINIMA=12
M4_HISTORIAL=5
M4_VIGENCIA_DIAS=90
M4_TEMPORAL_MINUTOS=60
M4_SESION_MINUTOS=60
M4_INACTIVIDAD_MINUTOS=10
M4_RECUPERACION_MINUTOS=20
M4_INTENTOS=3
M4_BLOQUEO_MINUTOS=10
M4_BLOQUEOS=3
# Opcional y sólo para el primer seed de desarrollo. Si se omite, se genera una clave aleatoria una sola vez.
M4_CLAVE_INICIAL=
# Aprovisionamiento explícito de la cuenta raíz en el servidor. Nunca guardar la clave real en Git.
M4_CLAVE_RAIZ=
M4_CORREO_RAIZ=
